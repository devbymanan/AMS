# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# Microsoft SQL Server Database Configuration
AMS_DB_DRIVER=ODBC Driver 17 for SQL Server
AMS_DB_SERVER=localhost
AMS_DB_NAME=AttendanceManagementSystem
AMS_DB_USER=sa
AMS_DB_PASSWORD=your_strong_password_here

# Biometric Device (ZKTeco) Configuration (Optional)
SBXPC_DLL_PATH=SBXPCDLL64.dll
DEVICE_IP=192.168.1.100
DEVICE_PORT=4370
DEVICE_PASSWORD=0
DEVICE_MACHINE_NUMBER=1
